# Control-plane database (any Postgres; Neon works)
DATABASE_URL=postgresql://user:password@host/axiom_platform?sslmode=require
# Required in production: signs admin sessions
PLATFORM_AUTH_SECRET=change-me-long-random
# Root domain that shops live under: <slug>.<ROOT_DOMAIN>
ROOT_DOMAIN=axiom.appbrainer.tech
# Shared secrets for server-to-server calls
GATE_SECRET=change-me-gate
CRON_SECRET=change-me-cron
# First super admin (used by db:seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
# Encrypts shop database URLs at rest: openssl rand -base64 32
SECRETS_KEY=change-me-base64-32-bytes
# Neon API access for shop provisioning (project that holds the shop databases)
NEON_API_KEY=
NEON_PROJECT_ID=
# Optional: NEON_BRANCH_ID (defaults to the default branch), NEON_API_BASE_URL (tests only)
# Optional: STORE_MIGRATIONS_DIR (defaults to ../store/src/db/migrations)
